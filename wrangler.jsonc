{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chain-reaction-relay",
  "main": "server/index.ts",
  "compatibility_date": "2025-01-01",

  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "PLAYER_HUB", "class_name": "PlayerHub" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] },
    { "tag": "v3", "new_sqlite_classes": ["PlayerHub"] },
    { "tag": "v4", "new_sqlite_classes": ["RateLimiter"] }
  ]
}
