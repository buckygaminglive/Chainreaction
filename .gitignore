# The upload signing key. Anyone holding this can sign an update that Play
# accepts as genuine, so it never goes near version control — keep the file and
# its password backed up somewhere private instead. Losing it means asking
# Google to reset the upload key; leaking it is worse.
*.keystore
*.jks

# Wrangler writes these during deploy. Tooling artifacts, not source.
certificates/
# Machine-specific Android SDK path, written by bubblewrap.
local.properties
