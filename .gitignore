node_modules
dist
dist-ssr
*.local
.DS_Store
.wrangler

# The old Trusted Web Activity shell (bubblewrap) lived at the repo root.
# Anchored with a leading slash so these patterns no longer swallow the
# Capacitor project's own app/, gradle/ and build.gradle under android/.
/.gradle
/build
/app
/gradle
/gradlew
/gradlew.bat
/build.gradle
/settings.gradle
/gradle.properties
/manifest-checksum.txt
*.apk
*.aab
*.idsig

# Native (Capacitor) build output. android/ itself is source and is committed;
# what Gradle and `cap sync` regenerate is not.
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/local.properties
android/.idea/
*.iml

# Upload-key passwords for release signing. See ANDROID.md.
keystore.properties

# The upload signing key. Anyone holding this can sign an update that Play
# accepts as genuine, so it never goes near version control — keep the file and
# its password backed up somewhere private instead. Losing it means asking
# Google to reset the upload key; leaking it is worse.
*.keystore
*.jks

# Wrangler writes these during deploy. Tooling artifacts, not source.
certificates/
# Machine-specific Android SDK path, written by bubblewrap.
local.properties
